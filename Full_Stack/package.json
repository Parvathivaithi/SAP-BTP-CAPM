{
  "name": "Full_Stack",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9.9.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-hospital": "cds watch --open hm.hospital/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/hospital"
  ],
  "cds": {
    "requires": {
      "[production]": {
        "auth": "mocked"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  }
}
