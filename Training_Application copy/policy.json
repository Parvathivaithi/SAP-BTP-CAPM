{
    "instance_min_count": 1,
    "instance_max_count": 3,
    "scaling_rules": [
        {
            "metric_type": "cpu",
            "breach_duration_secs": 60,
            "threshold": 3,
            "operator": ">=",
            "cool_down_secs": 60,
            "adjustment": "+1"
        },
        {
            "metric_type": "memory",
            "breach_duration_secs": 60,
            "threshold": 2,
            "operator": "<=",
            "cool_down_secs": 60,
            "adjustment": "-1"
        }
    ]
}