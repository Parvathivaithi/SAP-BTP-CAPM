{
  "name": "Training_Application",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4.7.0",
    "@sap-cloud-sdk/http-client": "^4.7.0",
    "@sap-cloud-sdk/resilience": "^4.7.0",
    "@sap/cds": "^9.9.1",
    "@sap/xssec": "^4",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "sqlite": "^5.1.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-training": "cds watch --open ta.training/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-employee": "cds watch --open ea.employee/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-feedback": "cds watch --open fa.feedback/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-employeefeedback": "cds watch --open fa.employeefeedback/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-feedbackemployee": "cds watch --open fa.feedbackemployee/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-emp": "cds watch --open ea.emp/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/training",
    "app/training",
    "app/employee",
    "app/feedback",
    "app/feedback",
    "app/employeefeedback",
    "app/feedbackemployee",
    "app/emp",
    "app/emp"
  ],
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true,
      "QrCodeAPI": {
        "kind": "rest",
        "credentials": {
          "destination": "QrCode"
        }
      },
      "Certificate_Api": {
        "kind": "rest",
        "credentials": {
          "destination": "Certificate_API"
        }
      }
    }
  }
}
