{
  "name": "DealerDetail",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4.5.1",
    "@sap-cloud-sdk/core": "^1.54.2",
    "@sap-cloud-sdk/http-client": "^4.5.1",
    "@sap-cloud-sdk/resilience": "^4.5.1",
    "@sap/cds": "^9.8.4",
    "@sap/cds-dk": "^9.8.2",
    "@sap/xssec": "^4",
    "axios": "^1.14.0",
    "express": "^4",
    "hana": "^0.0.2",
    "sqlite": "^5.1.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "npx cds run",
    "watch-dealer": "cds watch --open dealer/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "MapAPI": {
        "kind": "rest",
        "credentials": {
          "destination": "Task6Service"
        }
      },
      "[production]": {
        "auth": "mocked"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/dealer"
  ]
}
