{
  "name": "New_Fiori",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2.8.0",
    "@sap/cds": "^9.9.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-new": "cds watch --open nf.new/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-book": "cds watch --open bs.book/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/new",
    "app/book"
  ],
  "cds": {
    "requires": {
      "destinations": true,
      "html5-repo": true,
      "workzone": true,
      "auth": {
        "kind": "mocked"
      }
    }
  }
}
