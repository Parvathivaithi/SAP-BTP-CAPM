{
  "name": "translate_doc",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2.7.1",
    "@sap-cloud-sdk/connectivity": "^4.6.0",
    "@sap-cloud-sdk/http-client": "^4.6.0",
    "@sap-cloud-sdk/resilience": "^4.6.0",
    "@sap/cds": "^9.9.0",
    "form-data": "^4.0.5",
    "mammoth": "^1.12.0",
    "sqlite": "^5.1.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "translate": {
        "kind": "rest",
        "credentials": {
          "destination": "translation_Dest",
          "requestTimeout": 300000
        }
      }
    }
  }
}
